{
  "manifest_version": 3,
  "name": "Maddy New Tab",
  "version": "1.0.0",
  "description": "Shortcuts, groups, a todo list and deadlines on a calm, personal new tab page.",
  "minimum_chrome_version": "111",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["favicon", "search"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Maddy New Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
